# MH Game Shop — Caddy reverse proxy with automatic HTTPS (Let's Encrypt).
# Used by docker-compose.domain.yml. Requires DNS A-records for all four
# hostnames pointing at the server.

# Redirect www → apex (keeps a single CORS origin).
www.mhgameshop.com {
	redir https://mhgameshop.com{uri} permanent
}

# Storefront
mhgameshop.com {
	encode gzip
	# UddoktaPay is licensed to this domain, so its redirect/webhook must be
	# here — proxy those paths straight to the API (which also serves them).
	handle /uddoktapay* {
		reverse_proxy api:4000
	}
	handle {
		reverse_proxy web:3000
	}
}

# Admin panel
admin.mhgameshop.com {
	encode gzip
	reverse_proxy admin:3001
}

# API + websockets (Caddy proxies WebSocket upgrades automatically)
api.mhgameshop.com {
	encode gzip
	reverse_proxy api:4000
}

# Dizara CRM (standalone compose project; container joins this network)
crm.femorashop.com {
	encode gzip
	reverse_proxy dizara-crm:3001
}

# SafeCommerce — append this block to /opt/mhgameshop/Caddyfile on the VPS,
# then validate + graceful reload (see deploy/README.md). DNS: safecommerce.net
# (and later app/tenant subdomains) must A-record to the VPS first.

safecommerce.net {
	encode gzip

	# API + WebSocket → api container
	@api path /api/* /ws
	handle @api {
		reverse_proxy safecommerce-api:4000
	}

	# Everything else → static SPA (nginx)
	handle {
		reverse_proxy safecommerce-web:80
	}
}

auto.mhgameshop.com {
	encode gzip
	reverse_proxy 172.18.0.1:3000
}

quiz.mhgameshop.com {
	encode gzip
	reverse_proxy 172.18.0.1:4100
}
