{
  "name": "mhgameshop-node",
  "version": "1.0.0",
  "private": true,
  "description": "MH Game Shop — Node.js rewrite (Turborepo monorepo)",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "start": "turbo run start",
    "db:generate": "turbo run db:generate",
    "db:migrate": "npm run db:migrate -w @mhgs/database",
    "db:push": "npm run db:push -w @mhgs/database",
    "db:studio": "npm run db:studio -w @mhgs/database",
    "db:seed": "npm run db:seed -w @mhgs/database",
    "migrate:mysql": "npm run migrate:mysql -w @mhgs/database",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.3.3",
    "turbo": "^2.1.3",
    "typescript": "^5.6.2"
  },
  "packageManager": "npm@10.8.0",
  "engines": {
    "node": ">=18.0.0"
  }
}
