# ---- Server ----
NODE_ENV=development
PORT=4000
APP_URL=http://localhost:4000
WEB_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# ---- Database / Cache ----
DATABASE_URL=postgresql://mhgs:mhgs_secret@localhost:5432/mhgameshop?schema=public
REDIS_URL=redis://localhost:6379

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
# Set to false when serving over plain HTTP (e.g. IP-only deploy) so the auth
# cookie works. Use true only behind HTTPS.
COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ---- TopupNet (FreeFire / UniPin auto topup) ----
TOPUPNET_API_KEY=
TOPUPNET_BASE_URL=https://api.topupnet.com/api/v1

# ---- UddoktaPay gateway ----
UDDOKTAPAY_API_KEY=
UDDOKTAPAY_BASE_URL=

# ---- Telegram notifications ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
