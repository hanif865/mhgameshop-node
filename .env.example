# Root env — shared by docker-compose and workspace tooling.
# App-specific envs live in apps/api/.env and apps/web/.env.

# ---- PostgreSQL (docker-compose) ----
POSTGRES_USER=mhgs
POSTGRES_PASSWORD=mhgs_secret
POSTGRES_DB=mhgameshop
POSTGRES_PORT=5432

# ---- Redis (docker-compose) ----
REDIS_PORT=6379

# ---- Prisma / API ----
DATABASE_URL=postgresql://mhgs:mhgs_secret@localhost:5432/mhgameshop?schema=public
REDIS_URL=redis://localhost:6379

# ---- Legacy MySQL source (only used by scripts/migrate-from-mysql.ts) ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=netliverse_mhgs
